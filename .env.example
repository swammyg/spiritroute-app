# Copy to .env and adjust. Every value below is the default.

# --- Embeddings (spec section 3: 384-dim; all-MiniLM-L6-v2 or bge-small-en) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Vector store (Qdrant) ---
# Leave QDRANT_URL empty to use embedded, on-disk Qdrant (QDRANT_PATH, default ./data/qdrant).
# Set it (e.g. http://localhost:6333) to use a Qdrant server for larger scripture libraries.
QDRANT_URL=
QDRANT_API_KEY=
#QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=scriptures

# --- Search ---
# true: subtract the average of the 64 possible query vectors before searching, so the wording all
# queries share stops pulling every answer toward the same few passages. false: use the raw embeddings.
QUERY_CENTERING=true

# --- Light LLM served by Ollama (spec section 6) ---
# LLM_ENABLED=false skips the model entirely and always returns the built-in reflection template.
LLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=400
# Spec: "under 150 words total"
LLM_MAX_WORDS=150

# --- HTTP ---
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Safety (spec section 7) ---
# Wizard answers that should trigger the crisis override on their own, as JSON [emotion, driver] pairs.
# The spec names no such combinations, so the default is none. Example: [["Depressed","Worth"]]
CRISIS_SELECTION_TRIGGERS=[]
